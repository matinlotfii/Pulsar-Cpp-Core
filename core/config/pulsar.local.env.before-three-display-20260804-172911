
# Recommended: lock left/right assignment to the physical camera serial numbers.
PULSAR_LEFT_CAMERA_SERIAL=FCU22080658
PULSAR_RIGHT_CAMERA_SERIAL=FCU22080659

# CUDA/NPP canary: left camera only
PULSAR_GPU_PIPELINE=both
PULSAR_CAMERA_FPS=60
PULSAR_CAMERA_EXPOSURE_US=12000
PULSAR_CAMERA_SENSOR_SCALE=4

# Keep camera processing on CUDA, but render directly on the Xorg display GPU.
PULSAR_CORE_NVIDIA_OFFLOAD=0
PULSAR_CORE_NVIDIA_PROVIDER=NVIDIA-G0
PULSAR_SBS_PRESENT_VSYNC=1

# Double-buffered OpenGL PBO upload canary.
PULSAR_GL_PBO_UPLOAD=1

# Camera throughput canary: original visual profile, 350 MB/s link limit.

# Full-resolution throughput canary: 395 MB/s per camera.

# Stable full-resolution operating point: 350 MB/s per camera.
PULSAR_LEFT_CAMERA_PROFILE=camera/profiles/FCU22080659-throughput350.txt
PULSAR_RIGHT_CAMERA_PROFILE=camera/profiles/FCU22080659-throughput350.txt
PULSAR_CAMERA_PROFILE_ENABLED=1
PULSAR_CAMERA_PROFILE_VERIFY=1
PULSAR_CAMERA_PROFILE_REQUIRED=1

# This appliance has one settings display plus one required SBS output.
# Any other connected RTX outputs should mirror SBS automatically.
PULSAR_EXPECTED_DISPLAY_COUNT=2

# Fast three-display cold-boot configuration
PULSAR_DISPLAY_RETRY_COUNT=12
PULSAR_DISPLAY_RETRY_DELAY=1
PULSAR_DISPLAY_SETTLE_SAMPLES=2
PULSAR_DISPLAY_APPLY_DELAY=0.2
PULSAR_PREFERRED_SETTINGS_OUTPUT=HDMI-2
PULSAR_PREFERRED_MAIN_OUTPUT=DP-1-1
PULSAR_MIRROR_ALL_REMAINING=1
PULSAR_TOUCH_DEVICE_NAME="wch.cn USB2IIC_CTP_CONTROL"
PULSAR_SETTINGS_MODE=1024x600
PULSAR_SETTINGS_RATE=59.82
PULSAR_MAIN_MODE=1920x1080
PULSAR_MAIN_RATE=60.00
PULSAR_AR_MODE=1920x1080
PULSAR_AR_RATE=60.00
PULSAR_AR_LAYOUT=extend
PULSAR_DISPLAY_HOTPLUG_WATCH=1
PULSAR_DISPLAY_HOTPLUG_START_DELAY=8
PULSAR_DISPLAY_HOTPLUG_INTERVAL=1
PULSAR_DISPLAY_HOTPLUG_DEBOUNCE_SAMPLES=2
PULSAR_AUDIO_OUTPUT_VOLUME=125%
PULSAR_AUDIO_HOTPLUG_WATCH=1
PULSAR_AUDIO_HOTPLUG_INTERVAL=2
PULSAR_AUDIO_HOTPLUG_DEBOUNCE_SAMPLES=2
PULSAR_BOOT_PREFLIGHT_STABLE_SAMPLES=2
PULSAR_BOOT_PREFLIGHT_TIMEOUT_SEC=10
PULSAR_BOOT_PREFLIGHT_FINAL_DELAY_SEC=0.5
PULSAR_BOOT_PREFLIGHT_UDEV_SETTLE_TIMEOUT_SEC=2

# Stage 7: best-effort software startup alignment; no hardware trigger.
PULSAR_SOFTWARE_START_SYNC=1
PULSAR_SOFTWARE_START_SYNC_TIMEOUT_MS=5000
PULSAR_STEREO_PAIRING_MODE=latest
