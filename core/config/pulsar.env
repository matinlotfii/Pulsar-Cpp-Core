# Pulsar C++ Core defaults. Machine-specific values belong in pulsar.local.env.
PULSAR_PORT=4173

PULSAR_CAMERA_MODE=real

# Set serials to keep left/right assignment stable.
# Leave blank to use Galaxy SDK order 1/2.
PULSAR_LEFT_CAMERA_SERIAL=FCU22080658
PULSAR_RIGHT_CAMERA_SERIAL=FCU22080659

PULSAR_CAMERA_FPS=32
PULSAR_PREVIEW_FPS=15

PULSAR_CAMERA_MAX_WIDTH=1920
PULSAR_CAMERA_MAX_HEIGHT=1080
PULSAR_CAMERA_SENSOR_SCALE=4

PULSAR_CAMERA_BRIGHTNESS=60
PULSAR_CAMERA_EXPOSURE_US=30000
PULSAR_CAMERA_GAIN_DB_X10=0
PULSAR_CAMERA_AUTO_EXPOSURE=0

PULSAR_CAMERA_WHITE_BALANCE=Manual
PULSAR_CAMERA_WB_RED_X1000=2250
PULSAR_CAMERA_WB_GREEN_X1000=1000
PULSAR_CAMERA_WB_BLUE_X1000=1730

PULSAR_CAMERA_ENHANCE=Low
PULSAR_JPEG_QUALITY=88

PULSAR_DISPLAY_RETRY_COUNT=20
PULSAR_DISPLAY_RETRY_DELAY=1
PULSAR_DISPLAY_SETTLE_SAMPLES=3
PULSAR_DISPLAY_APPLY_DELAY=0.5
PULSAR_BOOT_PREFLIGHT_ENABLED=1
PULSAR_BOOT_PREFLIGHT_REQUIRED_CAMERAS=2
PULSAR_BOOT_PREFLIGHT_STABLE_SAMPLES=2
PULSAR_BOOT_PREFLIGHT_SAMPLE_INTERVAL_SEC=1
PULSAR_BOOT_PREFLIGHT_TIMEOUT_SEC=12
PULSAR_BOOT_PREFLIGHT_FINAL_DELAY_SEC=0.5
PULSAR_BOOT_PREFLIGHT_UDEV_SETTLE_TIMEOUT_SEC=3
PULSAR_BOOT_PREFLIGHT_NVIDIA_SMI_TIMEOUT_SEC=2
PULSAR_BOOT_PREFLIGHT_REQUIRE_NVIDIA=1

# Dynamic display selection is the default: the smallest native display is the
# settings/touch screen and the largest remaining display is the SBS screen.
# Every other connected output can mirror SBS through X11 automatically, or one
# extra output can run as an extended SBS screen with its own fullscreen window.
# Set exact connector names only when a machine needs a fixed mapping.
PULSAR_PREFERRED_SETTINGS_OUTPUT=
PULSAR_PREFERRED_MAIN_OUTPUT=
PULSAR_PREFERRED_AR_OUTPUT=
PULSAR_MIRROR_ALL_REMAINING=1

# Optional mode/rate overrides. Leave blank to use each monitor's EDID-preferred
# native mode and refresh rate. Set PULSAR_AR_LAYOUT=extend when exactly one
# aux output should stay independent; keep mirror mode when all extra panels
# should stay cloned at the X11 level.
PULSAR_SETTINGS_MODE=
PULSAR_SETTINGS_RATE=
PULSAR_MAIN_MODE=
PULSAR_MAIN_RATE=
PULSAR_AR_MODE=
PULSAR_AR_RATE=
PULSAR_AR_LAYOUT=mirror

# Restart the kiosk after a stable monitor connect/disconnect/replacement event
# so xrandr, SDL and the browser all rebuild against the new geometry.
PULSAR_DISPLAY_HOTPLUG_WATCH=0
PULSAR_DISPLAY_HOTPLUG_INTERVAL=2
PULSAR_DISPLAY_HOTPLUG_DEBOUNCE_SAMPLES=3

PULSAR_RENDER_MAIN=1
PULSAR_MAIN_DISPLAY=-1
PULSAR_SETTINGS_DISPLAY=-1

PULSAR_BROWSER_URL=http://127.0.0.1:4173/
PULSAR_BROWSER_GPU=1
PULSAR_HIDE_CURSOR=1
PULSAR_AUDIO_OUTPUT_VOLUME=125%
PULSAR_AUDIO_HOTPLUG_WATCH=0
PULSAR_AUDIO_HOTPLUG_INTERVAL=2
PULSAR_AUDIO_HOTPLUG_DEBOUNCE_SAMPLES=2
PULSAR_AUDIO_HOTPLUG_START_DELAY=6

PULSAR_TOUCH_DEVICE_NAME=
# GalaxyView exported camera profiles
PULSAR_LEFT_CAMERA_PROFILE=camera/profiles/FCU22080658-reference350-realtime.txt
PULSAR_RIGHT_CAMERA_PROFILE=camera/profiles/FCU22080659-reference350-realtime.txt

# Load profile automatically whenever the camera connects.
PULSAR_CAMERA_PROFILE_ENABLED=1

# Verify that Galaxy SDK applied the profile successfully.
PULSAR_CAMERA_PROFILE_VERIFY=1

# Do not start the camera with different settings if the profile is missing.
PULSAR_CAMERA_PROFILE_REQUIRED=1

PULSAR_HOST=0.0.0.0

# Exact visual profile from the known-good reference ZIP
PULSAR_GPU_PIPELINE=both
PULSAR_GL_PBO_UPLOAD=1
PULSAR_STEREO_PAIRING_MODE=latest

# RTX direct single-render low-latency V5
PULSAR_SBS_PRESENT_VSYNC=0
PULSAR_CORE_NVIDIA_OFFLOAD=0
__GL_SYNC_TO_VBLANK=0
vblank_mode=0
