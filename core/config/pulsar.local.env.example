# Copy this file to core/config/pulsar.local.env for machine-specific overrides.

# real = Daheng Galaxy SDK, mock = generated test cameras
# PULSAR_CAMERA_MODE=real

# Recommended: lock left/right assignment to the physical camera serial numbers.
PULSAR_LEFT_CAMERA_SERIAL=
PULSAR_RIGHT_CAMERA_SERIAL=

# Optional performance tuning.
# PULSAR_CAMERA_FPS=30
# PULSAR_PREVIEW_FPS=15
# PULSAR_CAMERA_MAX_WIDTH=1280
# PULSAR_CAMERA_MAX_HEIGHT=720
# PULSAR_JPEG_QUALITY=88

# Display selection is dynamic by default: smallest native display = settings,
# largest remaining display = SBS. Every remaining connected output can mirror
# SBS automatically, or one aux output can run as an extended SBS window.
# Optional exact connector overrides:
# PULSAR_PREFERRED_SETTINGS_OUTPUT=HDMI-2
# PULSAR_PREFERRED_MAIN_OUTPUT=DP-1-1
# Leave the AR output empty when NVIDIA connector names are not stable.
# PULSAR_PREFERRED_AR_OUTPUT=
# PULSAR_MIRROR_ALL_REMAINING=1
# PULSAR_EXPECTED_DISPLAY_COUNT=3
# PULSAR_DISPLAY_RETRY_COUNT=30
# PULSAR_DISPLAY_SETTLE_SAMPLES=3

# Optional native mode/rate overrides. Normally EDID-preferred values are used.
# Set `PULSAR_AR_LAYOUT=extend` only when exactly one aux output should stay
# independent while the renderer opens a second fullscreen SBS window there.
# Use `mirror` when every extra output should clone SBS through X11.
# PULSAR_AR_LAYOUT=mirror
# For mirrored aux outputs, keep main + aux on a shared mode/rate.
# PULSAR_SETTINGS_MODE=1024x600
# PULSAR_SETTINGS_RATE=59.82
# PULSAR_MAIN_MODE=1920x1080
# PULSAR_MAIN_RATE=60.00
# PULSAR_AR_MODE=1920x1080
# PULSAR_AR_RATE=60.00

# Automatically restart/reconfigure after monitor hotplug or replacement.
# For a fixed appliance topology, keep this disabled if NVIDIA connector names
# fluctuate and trigger unnecessary full-session rebuilds.
# PULSAR_DISPLAY_HOTPLUG_WATCH=0
# PULSAR_DISPLAY_HOTPLUG_INTERVAL=2
# PULSAR_DISPLAY_HOTPLUG_DEBOUNCE_SAMPLES=3

# Optional SDL display index override. Normally output-name auto-detection is used.
# PULSAR_MAIN_DISPLAY=1
# PULSAR_AR_DISPLAY=2
# PULSAR_SETTINGS_DISPLAY=0

# Optional touchscreen override. Leave unset for auto-detection.
# PULSAR_TOUCH_DEVICE_NAME=wch.cn USB2IIC_CTP_CONTROL

# Optional touchscreen edge trim for auto-calibration matrix.
# Values are fractions of the touchscreen area, typically between 0.00 and 0.05.
# PULSAR_TOUCH_INSET_LEFT=0.00
# PULSAR_TOUCH_INSET_RIGHT=0.00
# PULSAR_TOUCH_INSET_TOP=0.00
# PULSAR_TOUCH_INSET_BOTTOM=0.00
PULSAR_SETTINGS_MODE=1024x600
PULSAR_SETTINGS_RATE=59.82
PULSAR_MAIN_MODE=1920x1080
PULSAR_MAIN_RATE=70
PULSAR_AR_MODE=1920x1080
PULSAR_AR_RATE=90
PULSAR_MONITOR_LOGICAL_WIDTH=1920
PULSAR_MONITOR_LOGICAL_HEIGHT=1080
PULSAR_GLASS_LOGICAL_WIDTH=1920
PULSAR_GLASS_LOGICAL_HEIGHT=1080
PULSAR_DISPLAY_HOTPLUG_WATCH=1
PULSAR_DISPLAY_HOTPLUG_INTERVAL=1
PULSAR_DISPLAY_HOTPLUG_DEBOUNCE_SAMPLES=2
PULSAR_REQUIRE_TOUCH=0
