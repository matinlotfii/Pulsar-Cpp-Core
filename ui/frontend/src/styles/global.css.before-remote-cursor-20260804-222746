/* Phone-style lock layer and fixed kiosk behavior */
html,
body,
#root {
  width: 100%;
  height: 100%;
  overflow: hidden;
}

html,
body {
  touch-action: manipulation;
}

.app-root {
  position: relative;
  overflow: hidden;
}

.app-root.is-locked .viewport-frame {
  filter: blur(10px) saturate(0.92);
  transform: scale(0.992);
}

.lock-screen {
  position: fixed;
  inset: 0;
  z-index: 980;
  display: grid;
  place-items: center;
  padding: max(18px, env(safe-area-inset-top)) max(18px, env(safe-area-inset-right))
    max(18px, env(safe-area-inset-bottom)) max(18px, env(safe-area-inset-left));
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.8), rgba(236, 244, 247, 0.92)),
    linear-gradient(135deg, rgba(15, 111, 120, 0.1), rgba(45, 95, 243, 0.06));
  opacity: 0;
  pointer-events: none;
  transition:
    opacity 240ms ease,
    visibility 0s linear 240ms;
  visibility: hidden;
}

.lock-screen.is-visible {
  opacity: 1;
  pointer-events: auto;
  transition: opacity 240ms ease;
  visibility: visible;
}

.lock-glass {
  display: grid;
  width: min(420px, 100%);
  min-height: min(620px, calc(100svh - 36px));
  align-content: space-between;
  gap: 28px;
  padding: 24px;
  border: 1px solid rgba(75, 92, 108, 0.16);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.62);
  box-shadow:
    0 28px 90px rgba(19, 31, 42, 0.18),
    inset 0 1px 0 rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(24px);
  animation: lock-enter 300ms cubic-bezier(0.2, 0.72, 0.22, 1) both;
}

.lock-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.lock-status span,
.lock-status strong {
  display: inline-flex;
  align-items: center;
  min-height: 34px;
  padding: 6px 12px;
  border: 1px solid rgba(57, 75, 91, 0.12);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.68);
  box-shadow: 0 8px 18px rgba(25, 42, 55, 0.08);
  color: #17212b;
  font-size: 0.82rem;
  font-weight: 820;
}

.lock-status strong {
  color: #0b6d3b;
  background: rgba(226, 247, 235, 0.82);
}

.lock-identity {
  display: grid;
  justify-items: center;
  gap: 8px;
  text-align: center;
}

.lock-badge {
  display: inline-grid;
  width: 74px;
  height: 74px;
  place-items: center;
  border-radius: 50%;
  color: #fff;
  background: linear-gradient(135deg, #0f6f78, #2d5ff3);
  box-shadow:
    0 18px 38px rgba(15, 111, 120, 0.22),
    inset 0 1px 0 rgba(255, 255, 255, 0.28);
}

.lock-identity h2 {
  color: #101820;
  font-size: 2.4rem;
  line-height: 1;
}

.lock-identity > span:last-child {
  max-width: 300px;
  color: var(--color-muted);
  font-size: 0.92rem;
  font-weight: 720;
  line-height: 1.42;
}

.unlock-rail {
  display: grid;
  min-height: 108px;
  place-items: center;
  gap: 8px;
  padding: 12px;
  border: 1px solid rgba(57, 75, 91, 0.12);
  border-radius: 8px;
  color: #24303d;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.84), rgba(255, 255, 255, 0.62)),
    rgba(255, 255, 255, 0.72);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.72),
    0 14px 30px rgba(25, 42, 55, 0.12);
  cursor: pointer;
  touch-action: none;
}

.unlock-handle {
  display: inline-grid;
  width: 58px;
  height: 58px;
  place-items: center;
  border-radius: 50%;
  color: #fff;
  background: linear-gradient(135deg, #0f6f78, #2d5ff3);
  box-shadow: 0 12px 28px rgba(45, 95, 243, 0.24);
  transition: transform 120ms ease;
}

.unlock-rail span:last-child {
  color: #5f6d7a;
  font-size: 0.78rem;
  font-weight: 820;
}

.unlock-rail:active .unlock-handle {
  box-shadow:
    0 8px 18px rgba(45, 95, 243, 0.2),
    inset 0 3px 10px rgba(16, 24, 32, 0.16);
}

.capability-button[aria-label^="Record"] {
  background:
    linear-gradient(180deg, rgba(196, 60, 53, 0.1), rgba(255, 255, 255, 0)),
    rgba(255, 255, 255, 0.9);
}

@media (max-width: 760px) {
  .lock-glass {
    min-height: calc(100svh - 28px);
    padding: 18px;
  }

  .lock-identity h2 {
    font-size: 2rem;
  }

  .unlock-rail {
    min-height: 94px;
  }
}

@media (max-height: 520px) and (orientation: landscape) {
  .lock-glass {
    width: min(560px, 100%);
    min-height: calc(100svh - 28px);
    grid-template-columns: minmax(0, 1fr) minmax(180px, 0.72fr);
    align-items: center;
    align-content: center;
    gap: 18px;
  }

  .lock-status {
    grid-column: span 2;
  }

  .unlock-rail {
    min-height: 148px;
  }
}

@keyframes shell-enter {
  from {
    opacity: 0;
    transform: translateY(8px) scale(0.99);
  }

  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes lock-enter {
  from {
    opacity: 0;
    transform: translateY(14px) scale(0.98);
  }

  to {
    opacity: 1;
    transform: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .lock-glass,
  .viewport-frame,
  .page-transition,
  .boot-panel,
  .boot-progress::before {
    animation: none !important;
  }

  .lock-screen,
  .boot-screen,
  .unlock-handle {
    transition: none !important;
  }
}

@keyframes page-enter {
  from {
    opacity: 0;
    transform: translateY(6px);
  }

  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes boot-panel-enter {
  from {
    opacity: 0;
    transform: translateY(10px) scale(0.98);
  }

  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes boot-progress {
  from {
    transform: scaleX(0.08);
  }

  to {
    transform: scaleX(1);
  }
}

