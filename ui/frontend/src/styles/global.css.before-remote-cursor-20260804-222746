/* Liquid glass motion layer */
.liquid-glass-filters {
  position: fixed;
  width: 0;
  height: 0;
  pointer-events: none;
}

.viewport-frame,
.app-card,
.page-nav-button,
.status-pill,
.clock-readout,
.round-chip,
.power-button,
.unlock-rail,
.lock-glass,
.boot-panel,
.zoom-stepper button,
.zoom-presets button {
  position: relative;
  overflow: hidden;
}

.viewport-frame::before {
  position: absolute;
  inset: -38% -12%;
  z-index: 0;
  pointer-events: none;
  background:
    linear-gradient(116deg, transparent 22%, rgba(255, 255, 255, 0.52) 42%, transparent 59%),
    linear-gradient(68deg, transparent 34%, rgba(8, 145, 178, 0.08) 50%, transparent 66%);
  filter: url("#pulsar-liquid-glass");
  opacity: 0.54;
  transform: translate3d(-16%, -8%, 0) rotate(1deg);
  animation: liquid-stage-flow 12s ease-in-out infinite alternate;
}

.top-bar,
.app-layout,
.lock-screen,
.boot-screen {
  position: relative;
  z-index: 1;
}

.app-card::before,
.page-nav-button::before,
.status-pill::before,
.clock-readout::before,
.round-chip::before,
.power-button::before,
.unlock-rail::before,
.lock-glass::before,
.boot-panel::before,
.zoom-stepper button::before,
.zoom-presets button::before {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  border-radius: inherit;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.72), rgba(255, 255, 255, 0.08) 42%, transparent 68%),
    radial-gradient(circle at 20% 12%, rgba(255, 255, 255, 0.62), transparent 34%);
  opacity: 0.52;
  content: "";
  filter: url("#pulsar-liquid-glass");
  transform: translate3d(-8%, -6%, 0);
  animation: glass-sheen 7s ease-in-out infinite alternate;
}

.app-card > *,
.page-nav-button > *,
.status-pill > *,
.clock-readout > *,
.round-chip > *,
.power-button > *,
.unlock-rail > *,
.lock-glass > *,
.boot-panel > *,
.zoom-stepper button > *,
.zoom-presets button > * {
  position: relative;
  z-index: 1;
}

.app-card,
.page-nav-button,
.status-pill,
.clock-readout,
.round-chip,
.power-button,
.unlock-rail,
.lock-glass,
.boot-panel,
.zoom-stepper button,
.zoom-presets button {
  border-color: rgba(255, 255, 255, 0.68);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.82), rgba(255, 255, 255, 0.58)),
    rgba(255, 255, 255, 0.56);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.92),
    inset 0 -1px 0 rgba(16, 24, 40, 0.06),
    0 10px 26px rgba(16, 24, 40, 0.08);
  backdrop-filter: blur(22px) saturate(1.18);
}

.page-transition {
  animation: page-enter-liquid 310ms cubic-bezier(0.2, 0.72, 0.22, 1) both;
}

.home-status-card {
  animation: glass-card-enter 420ms cubic-bezier(0.2, 0.72, 0.22, 1) both;
}

.home-action-panel {
  animation: glass-card-enter 460ms 40ms cubic-bezier(0.2, 0.72, 0.22, 1) both;
}

.zoom-card {
  animation: glass-card-enter 500ms 80ms cubic-bezier(0.2, 0.72, 0.22, 1) both;
}

.home-action-panel .capability-button {
  transition:
    transform 170ms ease,
    box-shadow 170ms ease,
    border-color 170ms ease,
    background 170ms ease;
}

.home-action-panel .capability-button::after,
.page-nav-button::after,
.round-chip::after,
.power-button::after,
.zoom-stepper button::after,
.zoom-presets button::after,
.unlock-rail::after {
  position: absolute;
  inset: auto auto 50% 50%;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: color-mix(in srgb, var(--tone, #2d5ff3) 18%, #fff 82%);
  content: "";
  opacity: 0;
  pointer-events: none;
  transform: translate(-50%, 50%) scale(1);
  transition:
    opacity 220ms ease,
    transform 220ms ease;
}

