:root {
  color: #101820;
  background: #eef4f7;
  font-family:
    Figtree, "Noto Sans", Inter, ui-sans-serif, system-ui, -apple-system,
    BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-synthesis: none;
  text-rendering: geometricPrecision;
  -webkit-font-smoothing: antialiased;
  --color-primary: #0f6f78;
  --color-primary-strong: #0a5960;
  --color-success: #18864b;
  --color-warning: #b96d12;
  --color-danger: #c43c35;
  --color-info: #2d5ff3;
  --color-violet: #6850d8;
  --color-slate: #536171;
  --color-background: #eef4f7;
  --color-surface: rgba(255, 255, 255, 0.82);
  --color-surface-strong: rgba(255, 255, 255, 0.94);
  --color-on-surface: #101820;
  --color-muted: #5f6d7a;
  --color-border: rgba(57, 75, 91, 0.18);
  --color-ring: rgba(15, 111, 120, 0.35);
  --blue: var(--color-info);
  --green: var(--color-success);
  --orange: var(--color-warning);
  --red: var(--color-danger);
  --violet: var(--color-violet);
  --slate: var(--color-slate);
  --panel: var(--color-surface);
  --panel-strong: var(--color-surface-strong);
  --border: var(--color-border);
  --shadow: 0 16px 44px rgba(25, 42, 55, 0.13);
  --soft-shadow: 0 8px 18px rgba(25, 42, 55, 0.11);
}

* {
  box-sizing: border-box;
}

html {
  min-width: 320px;
  background: var(--color-background);
  scrollbar-width: none;
  overscroll-behavior: none;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  overflow-x: hidden;
  scrollbar-width: none;
  overscroll-behavior: none;
}

body::-webkit-scrollbar {
  width: 0;
  height: 0;
}

button,
input {
  font: inherit;
}

button {
  -webkit-tap-highlight-color: transparent;
  min-width: 44px;
  min-height: 44px;
  touch-action: manipulation;
  user-select: none;
}

button:focus-visible,
input:focus-visible {
  outline: 3px solid var(--color-ring);
  outline-offset: 3px;
}

.app-root {
  min-height: 100svh;
  padding: clamp(8px, 1.3vw, 22px);
  color: var(--color-on-surface);
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.86), rgba(255, 255, 255, 0)),
    linear-gradient(135deg, #f8fbfc 0%, #e6eff2 52%, #f4f8f9 100%);
}

.viewport-frame {
  width: min(100%, 1880px);
  min-height: calc(100svh - clamp(16px, 2.6vw, 44px));
  margin: 0 auto;
  overflow: hidden;
  border: 1px solid rgba(120, 130, 142, 0.18);
  border-radius: 8px;
  background: rgba(235, 241, 244, 0.78);
  box-shadow: 0 24px 80px rgba(24, 30, 38, 0.16);
  backdrop-filter: blur(20px);
}

.top-bar {
  display: grid;
  grid-template-columns: minmax(220px, auto) 1fr;
  align-items: center;
  min-height: clamp(34px, 4vw, 42px);
  padding: 0 clamp(8px, 1.4vw, 18px);
  border-bottom: 1px solid rgba(92, 99, 108, 0.14);
  background: rgba(255, 255, 255, 0.58);
}

.brand-lockup {
  display: flex;
  align-items: center;
  gap: 10px;
}

.brand-mark {
  display: inline-grid;
  place-items: center;
  width: 32px;
  height: 32px;
  border-radius: 999px;
  color: #fff;
  background: linear-gradient(135deg, var(--color-primary), #2d5ff3);
  box-shadow: 0 8px 18px rgba(15, 111, 120, 0.2);
  font-size: 0.68rem;
  font-weight: 850;
  letter-spacing: 0;
}

.brand-lockup strong,
.brand-lockup span {
  display: block;
}

.brand-lockup strong {
  color: #16202a;
  font-size: 0.9rem;
  line-height: 1.1;
}

.brand-lockup span {
  color: var(--color-muted);
  font-size: 0.72rem;
  font-weight: 680;
}

.status-icons {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: clamp(8px, 1.1vw, 16px);
  color: #333b45;
  font-weight: 740;
  white-space: nowrap;
}

.status-pill,
.clock-readout {
  display: inline-flex;
  align-items: center;
  min-height: 30px;
  gap: 6px;
  padding: 4px 10px;
  border: 1px solid rgba(57, 75, 91, 0.12);
  border-radius: 999px;
  color: #354150;
  background: rgba(255, 255, 255, 0.72);
  font-size: 0.78rem;
}

.status-pill.is-safe {
  color: #0b6d3b;
  background: rgba(226, 247, 235, 0.9);
}

.dashboard {
  display: grid;
  grid-template-columns: minmax(360px, 0.92fr) minmax(360px, 1fr);
  gap: clamp(14px, 2vw, 30px);
  padding: clamp(14px, 2vw, 28px);
}

.left-stack,
.right-stack {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: clamp(12px, 1.6vw, 20px);
}

.profile-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.profile-pill {
  display: flex;
  align-items: center;
  width: min(100%, 420px);
  gap: 12px;
  padding: 10px 14px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: var(--panel-strong);
  box-shadow: var(--soft-shadow);
}

.profile-pill strong,
.profile-pill span {
  display: block;
}

.profile-pill strong {
  color: #20252c;
  font-size: 0.96rem;
}

.profile-pill span {
  margin-top: 2px;
  color: #6d7681;
  font-size: 0.82rem;
}

.soft-button,
.icon-only,
.edit-button,
.round-chip,
.power-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--border);
  color: #3d4652;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: var(--soft-shadow);
  cursor: pointer;
  transition:
    transform 180ms ease,
    background 180ms ease,
    box-shadow 180ms ease,
    border-color 180ms ease;
}

.soft-button:hover,
.icon-only:hover,
.edit-button:hover,
.round-chip:hover,
.power-button:hover {
  transform: translateY(-1px);
  background: #fff;
  box-shadow: 0 12px 28px rgba(32, 42, 56, 0.15);
}

.soft-button:active,
.icon-only:active,
.edit-button:active,
.round-chip:active,
.power-button:active,
.scene-button:active,
.dial-actions button:active {
  transform: scale(0.97);
}

.soft-button,
.icon-only {
  width: 46px;
  height: 46px;
  border-radius: 50%;
}

.summary-block {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(210px, 0.62fr);
  align-items: end;
  gap: clamp(12px, 1.8vw, 20px);
  padding: clamp(4px, 1vw, 10px) 0;
}

.eyebrow {
  margin: 0 0 6px;
  color: #6f7b88;
  font-size: 0.76rem;
  font-weight: 800;
  letter-spacing: 0;
  text-transform: uppercase;
}

h1,
h2,
h3,
p {
  margin: 0;
}

h1 {
  max-width: 760px;
  color: #0f141a;
  font-size: 2.12rem;
  font-weight: 760;
  line-height: 1.08;
}

h2 {
  color: #151a20;
  font-size: 1.2rem;
  font-weight: 760;
}

h3 {
  color: #161b22;
  font-size: 0.98rem;
  font-weight: 760;
}

.muted {
  max-width: 620px;
  margin-top: 8px;
  color: var(--color-muted);
  font-size: 0.94rem;
  line-height: 1.5;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.micro-stat {
  min-width: 0;
  padding: 11px 12px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.66);
  box-shadow: 0 8px 18px rgba(44, 55, 70, 0.08);
}

.micro-stat span,
.micro-stat strong {
  display: block;
}

.micro-stat span {
  color: #7b8490;
  font-size: 0.74rem;
}

.micro-stat strong {
  margin-top: 4px;
  color: #252b33;
  font-size: 0.94rem;
}

.panel,
.detail-card,
.output-matrix,
.pedal-panel,
.settings-panel {
  border: 1px solid var(--border);
  border-radius: 8px;
  background: var(--panel);
  box-shadow: var(--shadow);
  backdrop-filter: blur(18px);
}

.scenes-panel {
  padding: clamp(12px, 1.5vw, 18px);
}

.panel-heading,
.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.icon-only {
  width: 40px;
  height: 40px;
}

.scene-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(118px, 1fr));
  gap: clamp(10px, 1.2vw, 16px);
  margin-top: 14px;
}

.scene-button {
  position: relative;
  display: grid;
  min-height: clamp(116px, 11vw, 146px);
  grid-template-rows: auto 1fr auto;
  justify-items: center;
  gap: 8px;
  padding: 12px 10px;
  border: 1px solid rgba(80, 89, 102, 0.12);
  border-radius: 8px;
  color: #18202a;
  background: rgba(255, 255, 255, 0.66);
  box-shadow: 0 10px 24px rgba(34, 45, 62, 0.12);
  cursor: grab;
  touch-action: none;
  transition:
    transform 180ms ease,
    border-color 180ms ease,
    background 180ms ease,
    box-shadow 180ms ease;
}

.scene-button:active {
  cursor: grabbing;
}

.scene-button.is-active {
  border-color: rgba(63, 99, 244, 0.36);
  background: rgba(255, 255, 255, 0.92);
  box-shadow:
    inset 0 -3px 0 color-mix(in srgb, var(--tone) 60%, transparent),
    0 16px 34px rgba(63, 99, 244, 0.16);
}

.scene-button.is-dragging {
  z-index: 3;
  opacity: 0.9;
}

.scene-icon,
.icon-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--tone);
  background: color-mix(in srgb, var(--tone) 16%, #fff 84%);
}

.scene-icon {
  width: clamp(48px, 5vw, 62px);
  height: clamp(48px, 5vw, 62px);
  box-shadow:
    inset 0 0 0 8px rgba(255, 255, 255, 0.58),
    0 8px 18px color-mix(in srgb, var(--tone) 22%, transparent);
}

.icon-badge {
  flex: 0 0 auto;
  width: 44px;
  height: 44px;
  box-shadow: inset 0 0 0 6px rgba(255, 255, 255, 0.62);
}

.scene-label {
  align-self: center;
  width: 100%;
  color: #1b222c;
  font-size: 0.9rem;
  font-weight: 760;
  line-height: 1.22;
  overflow-wrap: anywhere;
}

.scene-metric {
  color: #788290;
  font-size: 0.78rem;
  font-weight: 750;
}

.tone-blue {
  --tone: var(--blue);
}

.tone-green {
  --tone: var(--green);
}

.tone-orange {
  --tone: var(--orange);
}

.tone-red {
  --tone: var(--red);
}

.tone-violet {
  --tone: var(--violet);
}

.tone-slate {
  --tone: var(--slate);
}

.device-section {
  min-width: 0;
}

.section-title {
  margin-bottom: 12px;
}

.section-title span {
  display: block;
  margin-top: 3px;
  color: #727d89;
  font-size: 0.82rem;
}

.edit-button {
  height: 44px;
  gap: 8px;
  padding: 0 14px;
  border-radius: 999px;
  font-weight: 760;
}

.device-grid,
.settings-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: clamp(10px, 1.2vw, 14px);
}

.device-card {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 12px;
  min-width: 0;
  min-height: 96px;
  padding: 12px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.66);
  box-shadow: 0 10px 24px rgba(34, 45, 62, 0.1);
}

.device-card.is-online {
  background:
    linear-gradient(0deg, color-mix(in srgb, var(--tone) 10%, transparent), transparent),
    rgba(255, 255, 255, 0.74);
}

.device-card p,
.device-card span,
.device-card strong {
  overflow-wrap: anywhere;
}

.device-card p {
  margin-top: 3px;
  color: #6d7680;
  font-size: 0.82rem;
}

.device-card span {
  display: block;
  margin-top: 3px;
  color: #8a929c;
  font-size: 0.76rem;
}

.device-card > strong {
  color: var(--tone);
  font-size: 0.9rem;
  white-space: nowrap;
}

.primary-control {
  display: grid;
  justify-items: center;
  gap: clamp(12px, 1.5vw, 18px);
  min-height: 0;
  padding-top: 8px;
}

.exoscope-visual {
  position: relative;
  display: grid;
  place-items: center;
  width: min(82%, 520px);
  min-height: clamp(150px, 18vw, 260px);
}

.scope-head {
  position: relative;
  width: min(100%, 410px);
  height: clamp(66px, 8vw, 98px);
  border: 1px solid rgba(65, 75, 90, 0.16);
  border-radius: 8px;
  background:
    linear-gradient(180deg, #ffffff, #dfe7eb 70%, #f8fbfc),
    linear-gradient(90deg, transparent, rgba(88, 174, 197, 0.18), transparent);
  box-shadow:
    0 18px 35px rgba(42, 54, 66, 0.18),
    inset 0 -12px 20px rgba(98, 111, 125, 0.14);
}

.scope-head::before,
.scope-head::after {
  position: absolute;
  top: 32%;
  width: 34%;
  height: 16px;
  border-radius: 999px;
  background: #38414b;
  content: "";
}

.scope-head::before {
  left: 10%;
}

.scope-head::after {
  right: 10%;
}

.lens {
  position: absolute;
  top: 54%;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: radial-gradient(circle, #c7fbff 0%, #47b7c9 45%, #1b5c69 100%);
  box-shadow: 0 0 26px rgba(62, 198, 218, 0.38);
}

.lens.left {
  left: 23%;
}

.lens.right {
  right: 23%;
}

.scope-label {
  position: absolute;
  right: 14px;
  bottom: 8px;
  color: #68737e;
  font-size: 0.7rem;
  font-weight: 860;
}

.light-cone {
  position: absolute;
  top: clamp(82px, 10vw, 120px);
  width: 58%;
  height: clamp(82px, 11vw, 150px);
  clip-path: polygon(24% 0, 76% 0, 100% 100%, 0 100%);
  background: linear-gradient(
    180deg,
    rgba(83, 203, 218, 0.28),
    rgba(255, 255, 255, 0)
  );
  filter: blur(1px);
}

.stage-target {
  position: absolute;
  bottom: 0;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 16px;
  border: 1px solid var(--border);
  border-radius: 999px;
  color: #0b6f7b;
  background: rgba(255, 255, 255, 0.76);
  box-shadow: var(--soft-shadow);
  font-weight: 820;
}

.dial-wrap {
  display: grid;
  justify-items: center;
  gap: 10px;
  width: min(100%, 520px);
}

.dial {
  display: grid;
  place-items: center;
  width: clamp(184px, 22vw, 310px);
  aspect-ratio: 1;
  border-radius: 50%;
  padding: clamp(13px, 1.7vw, 20px);
  box-shadow: 0 18px 45px rgba(36, 43, 53, 0.12);
}

.dial-center {
  display: grid;
  place-items: center;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: rgba(247, 249, 250, 0.95);
  box-shadow: inset 0 0 0 1px rgba(88, 98, 111, 0.08);
}

.control-mode {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #838b95;
  font-size: 0.78rem;
  font-weight: 780;
  text-transform: uppercase;
}

.dial-center strong {
  color: #111820;
  font-size: 4rem;
  line-height: 0.95;
}

.dial-center small {
  color: #69747f;
  font-size: 0.86rem;
  font-weight: 720;
}

.dial-actions {
  display: flex;
  gap: 16px;
  margin-top: 8px;
}

.dial-actions button {
  display: inline-grid;
  place-items: center;
  width: clamp(40px, 4.2vw, 54px);
  height: clamp(40px, 4.2vw, 54px);
  border: 0;
  border-radius: 50%;
  color: #1b222b;
  background: #fff;
  box-shadow: var(--soft-shadow);
  font-size: 1.7rem;
  font-weight: 760;
  cursor: pointer;
}

.range-row,
.brightness-panel {
  display: grid;
  grid-template-columns: auto minmax(120px, 1fr) auto;
  align-items: center;
  gap: 10px;
  width: min(100%, 470px);
  color: #7a8490;
  font-size: 0.82rem;
  font-weight: 720;
}

input[type="range"] {
  width: 100%;
  min-height: 44px;
  accent-color: var(--blue);
  cursor: pointer;
}

.mode-strip {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: clamp(10px, 1.2vw, 16px);
  padding: 9px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: rgba(233, 232, 219, 0.72);
  box-shadow: var(--soft-shadow);
}

.round-chip {
  width: clamp(48px, 4.5vw, 58px);
  height: clamp(48px, 4.5vw, 58px);
  border-radius: 50%;
  color: var(--blue);
}

.round-chip.is-active {
  background: #fff;
  color: var(--blue);
}

.brightness-panel {
  grid-template-columns: minmax(130px, auto) minmax(130px, 1fr);
  padding: 12px 14px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.7);
  box-shadow: var(--soft-shadow);
}

.brightness-panel div {
  display: flex;
  align-items: center;
  gap: 10px;
  justify-content: space-between;
}

.brightness-panel strong {
  color: #202832;
}

.power-strip {
  display: flex;
  gap: 8px;
  padding: 8px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: rgba(226, 226, 215, 0.74);
  box-shadow: var(--soft-shadow);
}

.power-button {
  width: 52px;
  height: 52px;
  border-radius: 50%;
}

.power-button.is-on {
  color: #148a4b;
  background: #fff;
}

.detail-card,
.output-matrix,
.pedal-panel,
.settings-panel {
  padding: clamp(12px, 1.5vw, 18px);
}

.detail-card p {
  margin-top: 10px;
  color: var(--color-muted);
  line-height: 1.45;
}

.detail-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 9px;
  margin-top: 14px;
}

.detail-metrics div {
  min-width: 0;
  padding: 10px 11px;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.68);
}

.detail-metrics span,
.detail-metrics strong {
  display: block;
}

.detail-metrics span {
  color: #7c8590;
  font-size: 0.74rem;
}

.detail-metrics strong {
  margin-top: 3px;
  color: #202832;
  font-size: 0.9rem;
}

.action-tags,
.settings-items,
.pedal-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 13px;
}

.action-tags span,
.settings-items span,
.pedal-list span {
  display: inline-flex;
  align-items: center;
  min-height: 30px;
  padding: 5px 10px;
  border: 1px solid rgba(82, 93, 106, 0.12);
  border-radius: 999px;
  color: #51606f;
  background: rgba(255, 255, 255, 0.64);
  font-size: 0.76rem;
  font-weight: 720;
}

.route-list {
  display: grid;
  gap: 9px;
  margin-top: 12px;
}

.route-row {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) minmax(0, 1fr) auto;
  align-items: center;
  gap: 10px;
  padding: 10px;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.58);
}

.route-icon {
  display: inline-grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  color: var(--blue);
  background: rgba(63, 99, 244, 0.1);
}

.route-row strong,
.route-row span {
  display: block;
  overflow-wrap: anywhere;
}

.route-row strong {
  color: #222a34;
  font-size: 0.84rem;
}

.route-row span,
.route-row em {
  color: #75808b;
  font-size: 0.74rem;
  font-style: normal;
}

.settings-grid {
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  margin-top: 12px;
}

.settings-card {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 11px;
  padding: 12px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background:
    linear-gradient(0deg, color-mix(in srgb, var(--tone) 8%, transparent), transparent),
    rgba(255, 255, 255, 0.68);
}

.settings-card p {
  margin-top: 5px;
  color: #717c88;
  font-size: 0.82rem;
