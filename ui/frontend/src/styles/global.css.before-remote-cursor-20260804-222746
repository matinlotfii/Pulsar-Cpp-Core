  border-radius: 22px;
  background:
    linear-gradient(180deg, rgba(251, 253, 254, 0.98), rgba(227, 236, 242, 0.98)),
    rgba(255, 255, 255, 0.96);
  box-shadow: 0 22px 38px rgba(10, 31, 52, 0.22);
  animation: wifi-keyboard-rise 180ms ease;
  backdrop-filter: blur(16px);
  transition:
    opacity 160ms ease,
    transform 160ms ease;
}

.wifi-keyboard.is-hidden {
  opacity: 0;
  transform: translateY(14px);
  pointer-events: none;
}

.wifi-keyboard.is-open {
  opacity: 1;
  transform: translateY(0);
}

.wifi-keyboard-handle {
  justify-self: center;
  width: 52px;
  height: 5px;
  border-radius: 999px;
  background: rgba(90, 115, 136, 0.28);
}

.wifi-keyboard-preview {
  display: grid;
  gap: 4px;
  justify-items: center;
  padding: 10px 12px;
  border-radius: 14px;
  border: 1px solid rgba(115, 144, 170, 0.1);
  background: rgba(255, 255, 255, 0.92);
  text-align: center;
}

.wifi-keyboard-preview small {
  color: #5d7687;
  font-size: 0.72rem;
  font-weight: 780;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.wifi-keyboard-preview strong {
  display: block;
  width: 100%;
  min-height: 1.2em;
  color: #0b2234;
  font-size: 0.92rem;
  font-weight: 780;
  word-break: break-all;
  text-align: center;
}

.wifi-keyboard-rows {
  display: grid;
  gap: 8px;
}

.wifi-keyboard-row {
  display: grid;
  grid-template-columns: repeat(10, minmax(0, 1fr));
  gap: 6px;
}

.wifi-keyboard-row:nth-child(3) {
  grid-template-columns: repeat(9, minmax(0, 1fr));
}

.wifi-keyboard-row:nth-child(4) {
  grid-template-columns: 1.3fr repeat(7, minmax(0, 1fr)) 1.3fr;
}

.wifi-keyboard-row:nth-child(5) {
  grid-template-columns: repeat(10, minmax(0, 1fr));
}

.wifi-keyboard-row.is-bottom {
  grid-template-columns: 1.2fr 2fr 1.2fr;
}

.wifi-keyboard-key {
  min-height: 38px;
  padding: 0 8px;
  border: 0;
  border-radius: 10px;
  color: #0b2234;
  background: rgba(255, 255, 255, 0.96);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.98),
    0 6px 14px rgba(53, 82, 106, 0.08);
  font-size: 0.88rem;
  font-weight: 800;
  cursor: pointer;
}

.wifi-keyboard-key.is-wide,
.wifi-keyboard-key.is-space {
  min-width: 0;
}

.wifi-keyboard-key.is-shift {
  position: relative;
}

.wifi-keyboard-key.is-shift.is-active {
  color: #ffffff;
  background: linear-gradient(135deg, #18b5c0, #145fd6);
}

.wifi-shift-icon {
  position: relative;
  display: inline-block;
  width: 18px;
  height: 18px;
}

.wifi-shift-icon::before {
  position: absolute;
  left: 50%;
  top: 2px;
  width: 10px;
  height: 10px;
  transform: translateX(-50%) rotate(45deg);
  border-top: 1.85px solid currentColor;
  border-left: 1.85px solid currentColor;
  content: "";
}

.wifi-shift-icon::after {
  position: absolute;
  left: 50%;
  bottom: 2px;
  width: 8px;
  height: 9px;
  transform: translateX(-50%);
  border: 1.85px solid currentColor;
  border-top: 0;
  border-radius: 0 0 2px 2px;
  content: "";
}

.wifi-keyboard-key:active {
  background: rgba(228, 240, 248, 0.98);
}

.wifi-primary-button,
.wifi-secondary-button,
.wifi-ghost-button {
  min-height: 40px;
  padding: 0 14px;
  border-radius: 12px;
  font-size: 0.8rem;
  font-weight: 800;
}

.wifi-primary-button {
  border: 0;
  color: #ffffff;
  background: linear-gradient(135deg, #18b5c0, #145fd6);
  box-shadow: 0 14px 28px rgba(20, 95, 214, 0.2);
}

.wifi-primary-button.is-speed {
  min-width: 148px;
}

.wifi-secondary-button {
  border: 1px solid rgba(77, 109, 139, 0.16);
  color: #0a2234;
  background: rgba(255, 255, 255, 0.84);
}

.wifi-ghost-button {
  border: 1px solid rgba(52, 76, 95, 0.18);
  color: #173247;
  background: linear-gradient(180deg, rgba(246, 250, 252, 0.98), rgba(216, 226, 234, 0.92));
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.96);
}

.wifi-ghost-button:active {
  background: linear-gradient(180deg, rgba(232, 239, 244, 0.98), rgba(204, 217, 227, 0.94));
}

.wifi-primary-button:disabled,
.wifi-secondary-button:disabled {
  opacity: 0.62;
  box-shadow: none;
}

.wifi-speed-panel {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
}

.wifi-speed-panel span {
  display: grid;
  gap: 4px;
  padding: 10px 12px;
  border-radius: 12px;
  border: 1px solid rgba(115, 144, 170, 0.08);
  background: rgba(255, 255, 255, 0.82);
}

.wifi-speed-panel span.is-live {
  border: 1px solid rgba(115, 144, 170, 0.08);
  background: rgba(255, 255, 255, 0.82);
  box-shadow: none;
}

.wifi-speed-panel small {
  color: #547181;
  font-size: 0.7rem;
  font-weight: 780;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.wifi-speed-panel strong {
  color: #071827;
  font-size: 0.95rem;
  font-weight: 860;
}

.wifi-inline-message,
.wifi-empty-state {
  display: grid;
  place-items: center;
  min-height: 40px;
  padding: 10px 12px;
  border-radius: 12px;
  border: 1px solid rgba(115, 144, 170, 0.08);
  color: #506779;
  background: rgba(232, 241, 246, 0.72);
  font-size: 0.78rem;
  font-weight: 740;
  text-align: center;
}

.wifi-speed-panel .wifi-inline-message {
  grid-column: 1 / -1;
  justify-self: stretch;
  color: #0b5f79;
  background: linear-gradient(135deg, rgba(34, 197, 94, 0.14), rgba(20, 95, 214, 0.14));
  border: 1px solid rgba(24, 181, 192, 0.18);
  text-align: center;
}

.wifi-inline-message.is-error {
  color: #8a2435;
  background: rgba(255, 235, 238, 0.9);
}

@keyframes wifi-keyboard-rise {
  from {
    opacity: 0;
    transform: translateY(18px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 920px) {
  .wifi-sheet-backdrop {
    padding: 18px;
  }

  .wifi-sheet {
    width: 100%;
    height: 100%;
    border-radius: 22px;
  }

  .wifi-sheet.is-keyboard-open {
    padding-bottom: 344px;
  }

  .wifi-sheet-body {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) auto;
  }

  .wifi-sheet-footer {
    justify-content: stretch;
  }

  .wifi-sheet-footer .wifi-secondary-button,
  .wifi-sheet-footer .wifi-ghost-button {
    flex: 1 1 0;
  }

  .wifi-connect-card {
    min-height: 180px;
  }

  .wifi-keyboard {
    right: 14px;
    bottom: 14px;
    left: 14px;
  }
}

.hmi-toast {
  position: absolute;
  left: 50%;
  bottom: 16px;
  z-index: 20;
  min-height: 44px;
  max-width: 72%;
  padding: 12px 18px;
  transform: translateX(-50%);
  border: 1px solid rgba(25, 194, 204, 0.2);
  border-radius: 999px;
  color: #071827;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 18px 38px rgba(23, 66, 94, 0.16);
  font-size: 0.86rem;
  font-weight: 850;
  text-align: center;
  pointer-events: none;
}

.exact-page-switcher {
  right: 13px;
  bottom: 9px;
  grid-template-columns: repeat(9, 20px);
  gap: 4px;
  opacity: 0;
}

.designed-hmi-frame:focus-within .exact-page-switcher {
  opacity: 0.72;
}

.exact-page-dot {
  width: 20px;
  height: 20px;
  min-width: 20px;
  min-height: 20px;
  color: #4a5f71;
  background: rgba(255, 255, 255, 0.68);
  font-size: 0.55rem;
}

.exact-page-dot.is-active {
  background: #18b8c6;
}

@keyframes home-control-enter {
  from {
    transform: translateY(12px) scale(0.96);
  }
  to {
    transform: translateY(0) scale(1);
  }
}

@keyframes control-sheen {
  from {
    transform: translateX(-70%);
  }
  to {
    transform: translateX(80%);
  }
}

@keyframes home-reorder-breathe {
  0% {
    transform: translate3d(0, 0, 0) rotate(0deg) scale(0.998);
  }
  48% {
    transform: translate3d(var(--reorder-x, 0.6px), var(--reorder-y, -0.8px), 0) rotate(var(--reorder-rotate, 0.18deg)) scale(1.008);
  }
  100% {
    transform: translate3d(var(--reorder-x-alt, -0.5px), var(--reorder-y-alt, 0.7px), 0) rotate(var(--reorder-rotate-alt, -0.2deg)) scale(1.002);
  }
}

@keyframes home-reorder-icon-breathe {
  0% {
    transform: translate3d(0, 0, 0) scale(0.992);
  }
  100% {
    transform: translate3d(0, var(--reorder-icon-y, -0.8px), 0) scale(1.018);
  }
}

@keyframes home-icon-color-flow {
  from {
    transform: rotate(0deg) scale(1);
  }
  to {
    transform: rotate(360deg) scale(1);
  }
}

@keyframes home-icon-white-sheen {
  0%,
  34% {
    opacity: 0;
    transform: translateX(-72%);
  }
  48% {
    opacity: 0.46;
  }
  64%,
  100% {
    opacity: 0;
    transform: translateX(72%);
  }
}

@keyframes camera-reconnect-orbit {
  from {
    transform: rotate(0deg) scale(1);
  }
  to {
    transform: rotate(360deg) scale(1);
  }
}

@keyframes device-float {
  0%,
  100% {
    transform: translateY(8px);
  }
  50% {
    transform: translateY(-2px);
  }
}

@keyframes aura-breathe {
  0%,
  100% {
    opacity: 0.74;
    transform: scale(0.98);
  }
  50% {
    opacity: 1;
    transform: scale(1.04);
  }
}

@keyframes orbit-rotate {
  from {
    rotate: 0deg;
  }
  to {
    rotate: 360deg;
  }
}

@keyframes pulse-dot {
  0% {
    box-shadow: 0 0 0 0 rgba(32, 214, 107, 0.42);
  }
  70% {
    box-shadow: 0 0 0 9px rgba(32, 214, 107, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(32, 214, 107, 0);
  }
}

@keyframes logo-pulse {
  0% {
    opacity: 0.72;
    transform: scale(0.92);
  }
  70% {
    opacity: 0;
    transform: scale(1.36);
  }
  100% {
    opacity: 0;
    transform: scale(1.36);
  }
}

@keyframes home-ring-drift {
  from {
    rotate: 0deg;
  }
  to {
    rotate: 360deg;
  }
}

@keyframes home-core-breathe {
  0%,
  100% {
    opacity: 0.72;
    transform: scale(0.96);
  }
  50% {
    opacity: 1;
    transform: scale(1.04);
  }
}

@keyframes home-line-drift {
  0%,
  100% {
    opacity: 0.46;
    translate: -10px 0;
  }
  50% {
    opacity: 0.94;
    translate: 10px 0;
  }
}

@keyframes home-scan-slide {
  0%,
  100% {
    opacity: 0.46;
    transform: translateX(-8px) scaleX(0.92);
  }
  50% {
    opacity: 0.9;
    transform: translateX(8px) scaleX(1.04);
  }
}

@keyframes pulsar-brand-spectrum {
  0%,
  100% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .home-float-button,
  .home-core-wordmark strong,
  .home-pulsar-core::before,
  .home-brand-lines span,
  .home-brand-scan,
  .home-core-rings span,
  .home-device-stage .device-tower,
  .device-aura,
  .device-orbit,
  .pulse-dot,
  .home-command-layout.is-reordering .home-launch-button,
  .home-command-layout.is-reordering .home-launch-icon,
  .home-launch-icon::before,
  .home-launch-icon::after,
  .camera-disconnect-orbit span,
  .pulsar-mark::before {
    animation: none;
  }

  .home-float-button,
  .home-float-button:hover,
  .home-float-button[data-pressed],
  .home-launch-button,
  .home-launch-button[data-pressed] {
    transition: none;
    transform: none;
  }
}
