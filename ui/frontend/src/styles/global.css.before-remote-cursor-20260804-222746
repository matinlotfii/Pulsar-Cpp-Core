/* Startup and tactile polish */
.viewport-frame {
  animation: shell-enter 360ms cubic-bezier(0.2, 0.72, 0.22, 1) both;
}

.page-transition {
  display: grid;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  animation: page-enter 230ms cubic-bezier(0.2, 0.72, 0.22, 1) both;
}

.page-transition > .page-grid {
  min-height: 0;
}

.boot-screen {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: grid;
  place-items: center;
  padding: 18px;
  color: var(--color-on-surface);
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(239, 246, 248, 0.96)),
    linear-gradient(135deg, rgba(15, 111, 120, 0.06), rgba(45, 95, 243, 0.04));
  opacity: 0;
  pointer-events: none;
  transition:
    opacity 280ms ease,
    visibility 0s linear 280ms;
  visibility: hidden;
}

.boot-screen.is-visible {
  opacity: 1;
  pointer-events: auto;
  transition: opacity 280ms ease;
  visibility: visible;
}

.boot-panel {
  display: grid;
  width: min(460px, 100%);
  gap: 14px;
  padding: 22px;
  border: 1px solid rgba(74, 91, 108, 0.16);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.86);
  box-shadow:
    0 28px 90px rgba(22, 34, 44, 0.16),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(22px);
  animation: boot-panel-enter 320ms cubic-bezier(0.2, 0.72, 0.22, 1) both;
}

.boot-mark {
  display: inline-grid;
  width: 62px;
  height: 62px;
  place-items: center;
  border-radius: 50%;
