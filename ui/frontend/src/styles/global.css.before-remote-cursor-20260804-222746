}

.zoom-lens {
  animation: lens-breathe 3.6s ease-in-out infinite;
}

.zoom-scan-line {
  animation: scan-flow 2.7s ease-in-out infinite alternate;
}

.zoom-crosshair {
  animation: focus-pulse 2.4s ease-in-out infinite;
}

.boot-panel,
.lock-glass {
  animation: glass-card-enter 420ms cubic-bezier(0.2, 0.72, 0.22, 1) both;
}

@keyframes liquid-stage-flow {
  from {
    transform: translate3d(-18%, -9%, 0) rotate(0.5deg);
  }

  to {
    transform: translate3d(12%, 8%, 0) rotate(-1deg);
  }
}

@keyframes glass-sheen {
  from {
    opacity: 0.34;
    transform: translate3d(-10%, -7%, 0);
  }

  to {
    opacity: 0.68;
    transform: translate3d(8%, 6%, 0);
  }
}

@keyframes glass-card-enter {
  from {
    opacity: 0;
    transform: translateY(12px) scale(0.985);
  }

  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes page-enter-liquid {
  from {
    opacity: 0;
    transform: translateY(10px) scale(0.99);
  }

  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes zoom-float {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-4px);
  }
}

@keyframes lens-breathe {
  0%,
  100% {
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.72),
      0 16px 32px rgba(16, 24, 40, 0.1);
  }

  50% {
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.9),
      0 18px 34px rgba(8, 145, 178, 0.16);
  }
}

@keyframes scan-flow {
  from {
    opacity: 0.45;
    transform: translateY(12%);
  }

  to {
    opacity: 0.8;
    transform: translateY(30%);
  }
}

@keyframes focus-pulse {
  0%,
  100% {
    transform: scale(1);
  }

  50% {
    transform: scale(1.045);
  }
}

@media (max-width: 760px) {
