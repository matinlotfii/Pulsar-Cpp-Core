@@ -60,7 +60,12 @@ ExecStartPre=$PULSAR_ROOT/core/scripts/pulsar-boot-preflight.sh
 TimeoutStartSec=0
 DROPIN
 
-chmod 0755 "$PULSAR_ROOT/core/scripts/touch-hotplug-event.sh"
