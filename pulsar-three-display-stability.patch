diff --git a/core/config/pulsar.local.env b/core/config/pulsar.local.env
index d298220..f7333ad 100644
--- a/core/config/pulsar.local.env
+++ b/core/config/pulsar.local.env
@@ -28,19 +28,21 @@ PULSAR_CAMERA_PROFILE_ENABLED=1
 PULSAR_CAMERA_PROFILE_VERIFY=1
 PULSAR_CAMERA_PROFILE_REQUIRED=1
 
-# This appliance has one settings display plus one required SBS output.
-# Any other connected RTX outputs should mirror SBS automatically.
+# This appliance has one settings display, one main SBS display, and one
+# X-real AR output. Wait for all three before starting the kiosk so connector
+# discovery cannot change the display roles after the session is running.
 PULSAR_EXPECTED_DISPLAY_COUNT=3
 
-# Fast three-display cold-boot configuration
-PULSAR_DISPLAY_RETRY_COUNT=12
+# Stable three-display cold-boot configuration.
+PULSAR_DISPLAY_RETRY_COUNT=30
 PULSAR_DISPLAY_RETRY_DELAY=1
-PULSAR_DISPLAY_SETTLE_SAMPLES=2
+PULSAR_DISPLAY_SETTLE_SAMPLES=3
 PULSAR_DISPLAY_APPLY_DELAY=0.2
 PULSAR_PREFERRED_SETTINGS_OUTPUT=HDMI-2
 PULSAR_PREFERRED_MAIN_OUTPUT=DP-1-1
-PULSAR_PREFERRED_AR_OUTPUT=HDMI-1-0
-PULSAR_MIRROR_ALL_REMAINING=0
+# Do not pin the AR connector name: NVIDIA may rename it between boots.
+PULSAR_PREFERRED_AR_OUTPUT=
+PULSAR_MIRROR_ALL_REMAINING=1
 PULSAR_TOUCH_DEVICE_NAME="wch.cn USB2IIC_CTP_CONTROL"
 PULSAR_SETTINGS_MODE=1024x600
 PULSAR_SETTINGS_RATE=59.82
@@ -52,7 +54,9 @@ PULSAR_AR_LAYOUT=mirror
 
 # Keep the UI visible even when the mixed-GPU ANGLE path fails during boot.
 PULSAR_BROWSER_GPU=0
-PULSAR_DISPLAY_HOTPLUG_WATCH=1
+# This is a fixed appliance topology. The NVIDIA connector names can fluctuate
+# and were causing the live watcher to terminate and rebuild a healthy session.
+PULSAR_DISPLAY_HOTPLUG_WATCH=0
 PULSAR_DISPLAY_HOTPLUG_START_DELAY=8
 PULSAR_DISPLAY_HOTPLUG_INTERVAL=1
 PULSAR_DISPLAY_HOTPLUG_DEBOUNCE_SAMPLES=2
diff --git a/core/config/pulsar.local.env.example b/core/config/pulsar.local.env.example
index 4799111..cea441e 100644
--- a/core/config/pulsar.local.env.example
+++ b/core/config/pulsar.local.env.example
@@ -20,9 +20,12 @@ PULSAR_RIGHT_CAMERA_SERIAL=
 # Optional exact connector overrides:
 # PULSAR_PREFERRED_SETTINGS_OUTPUT=HDMI-2
 # PULSAR_PREFERRED_MAIN_OUTPUT=DP-1-1
-# PULSAR_PREFERRED_AR_OUTPUT=HDMI-1-0
+# Leave the AR output empty when NVIDIA connector names are not stable.
+# PULSAR_PREFERRED_AR_OUTPUT=
 # PULSAR_MIRROR_ALL_REMAINING=1
-# PULSAR_EXPECTED_DISPLAY_COUNT=2
+# PULSAR_EXPECTED_DISPLAY_COUNT=3
+# PULSAR_DISPLAY_RETRY_COUNT=30
+# PULSAR_DISPLAY_SETTLE_SAMPLES=3
 
 # Optional native mode/rate overrides. Normally EDID-preferred values are used.
 # Set `PULSAR_AR_LAYOUT=extend` only when exactly one aux output should stay
@@ -38,7 +41,9 @@ PULSAR_RIGHT_CAMERA_SERIAL=
 # PULSAR_AR_RATE=60.00
 
 # Automatically restart/reconfigure after monitor hotplug or replacement.
-# PULSAR_DISPLAY_HOTPLUG_WATCH=1
+# For a fixed appliance topology, keep this disabled if NVIDIA connector names
+# fluctuate and trigger unnecessary full-session rebuilds.
+# PULSAR_DISPLAY_HOTPLUG_WATCH=0
 # PULSAR_DISPLAY_HOTPLUG_INTERVAL=2
 # PULSAR_DISPLAY_HOTPLUG_DEBOUNCE_SAMPLES=3
 
